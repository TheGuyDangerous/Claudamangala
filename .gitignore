# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcscmblueprint

# XcodeGen-generated project — regenerated from project.yml, don't track
# the mutable pieces of it. (The .xcodeproj itself is regenerated by CI
# via `xcodegen generate`, so it isn't committed either.)
*.xcodeproj/
*.xcworkspace/

# SPM
.build/
.swiftpm/

# Firebase config — never committed, injected by CI from a GitHub secret
GoogleService-Info.plist
PipelineConfig.plist

# Packaging output
*.dmg
build-output/

.DS_Store
