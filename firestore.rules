rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared Claude account registry — any signed-in Claudamangala user.
    // GitHub Actions uses the Admin SDK and bypasses these rules.
    match /claude_accounts/{accountId} {
      allow read, write: if request.auth != null;
    }

    // OAuth client settings for local token refresh (not in the public repo).
    // Any signed-in app user may read; only the owner may update.
    match /app_config/oauth {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == "tRrq8mT9vaVVacjbo5OPHFMK53L2";
    }

    // Pipeline trigger config. Owner-only — also gates cloud refresh in the app.
    match /app_config/pipeline {
      allow read, write: if request.auth != null
                         && request.auth.uid == "tRrq8mT9vaVVacjbo5OPHFMK53L2";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
