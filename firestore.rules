rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared Claude account registry — any signed-in Claudamangala user.
    // GitHub Actions uses the Admin SDK and bypasses these rules.
    match /claude_accounts/{accountId} {
      allow read, write: if request.auth != null;
    }

    // Owner-only in Firestore rules. Claudamangala probes read access here
    // to decide whether Local vs Cloud refresh appears in Preferences.
    match /app_config/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == "tRrq8mT9vaVVacjbo5OPHFMK53L2";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
